{
  "name": "@mcmillan/me1-mate-web",
  "version": "0.1.0",
  "description": "Browser editor for Allen & Heath ME-1 configs and ME-U channel setups",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:voiceover": "playwright test -c playwright.voiceover.config.ts"
  },
  "dependencies": {
    "@mcmillan/me1-mate-core": "workspace:*",
    "@tamagui/config": "^3.2.2",
    "@tamagui/core": "3.2.2",
    "@tamagui/vite-plugin": "^3.2.2",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tamagui": "^3.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@guidepup/guidepup": "^0.40.0",
    "@guidepup/playwright": "^0.21.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
}
